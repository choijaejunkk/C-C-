#include <stdio.h>

// 구조체는 main 함수 바깥에 선언합니다.
struct Student {
    char name[50];
    int score;
};

int main() {
    struct Student s;
    FILE *fp;
    FILE *pass;
    FILE *fail;

    int count;
    fp = fopen("student.txt", "w");

    if (fp == NULL) {
        printf("파일 열기 실패\n");
        return 1;
    }
    
    printf("학생 수: ");
    scanf("%d", &count);

    for (int i = 0; i < count; i++) {
        printf("\n%d번째 학생 이름: ", i + 1);
        scanf("%49s", s.name);
        printf("점수: ");
        scanf("%d", &s.score);

        fprintf(fp, "%s %d\n", s.name, s.score);
    }
    fclose(fp);

    // 읽기 및 쓰기 모드로 파일들 열기
    fp = fopen("student.txt", "r");
    pass = fopen("pass.txt", "w");
    fail = fopen("fail.txt", "w");

    if (fp == NULL || pass == NULL || fail == NULL) {
        printf("파일 열기 실패\n");

        if (fp != NULL) fclose(fp);
        if (pass != NULL) fclose(pass);
        if (fail != NULL) fclose(fail);

        return 1;
    }

    // while 문 내부에 중괄호를 추가하고 fail.txt 저장 로직을 완성합니다.
    while (fscanf(fp, "%49s %d", s.name, &s.score) == 2) {
        if (s.score >= 80) {
            fprintf(pass, "%s %d\n", s.name, s.score);
        } else {
            fprintf(fail, "%s %d\n", s.name, s.score); // 80점 미만인 경우 fail.txt에 기록
        }
    }

    // 파일 닫기
    fclose(fp);
    fclose(pass);
    fclose(fail);
    
    printf("\n파일 저장 및 분류 완료!\n");

    return 0;
}
